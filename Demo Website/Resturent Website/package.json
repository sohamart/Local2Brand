{
  "name": "resturent-website",
  "version": "1.0.0",
  "description": "L'Amour Gourmet Luxury Restaurant Web Platform with Online Ordering, WhatsApp, Razorpay, Live Tracking & Admin Panel",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "restaurant",
    "food-delivery",
    "razorpay",
    "whatsapp-order",
    "order-tracking",
    "admin-dashboard"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cloudinary": "^2.11.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "form-data": "^4.0.6"
  }
}
