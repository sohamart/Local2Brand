{
  "name": "resturent-website",
  "version": "1.0.0",
  "private": true,
  "description": "L'Amour Gourmet Restaurant Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"node backend/index.js\" \"npm --prefix frontend run dev\"",
    "backend": "node backend/index.js",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node backend/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
