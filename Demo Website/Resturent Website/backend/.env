# ==========================================
# L'AMOUR GOURMET & GRILL - BACKEND CONFIG
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# CORS & Allowed Client URLs (comma-separated or * for wildcard)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:5000,*

# JSON Web Token Secret Key
JWT_SECRET=lamour_gourmet_jwt_secret_2026_super_secure_key

# Default Administrator Credentials
ADMIN_NAME="Restaurant Master Admin"
ADMIN_EMAIL=admin@restaurant.com
ADMIN_PASSWORD=admin123

# Razorpay Payment Gateway Keys (Add your Live or Test keys here)
RAZORPAY_KEY_ID=rzp_test_YourKeyHere123
RAZORPAY_KEY_SECRET=YourSecretKeyHere
ENABLE_RAZORPAY=true

# Store & Contact Details
RESTAURANT_NAME="L'Amour Gourmet & Grill"
RESTAURANT_TAGLINE="Authentic Charcoal Grills & Artisanal Cuisine"
RESTAURANT_PHONE="+91 98765 43210"
RESTAURANT_WHATSAPP=919876543210
RESTAURANT_EMAIL=contact@lamourgourmet.com
RESTAURANT_ADDRESS="12/A Park Avenue, Gourmet Boulevard, Central City"
RESTAURANT_LAT=22.5726
RESTAURANT_LNG=88.3639
OPENING_HOURS="11:30 AM - 11:30 PM (Mon-Sun)"

# Direct UPI QR Payment Configuration
ENABLE_UPI_QR=true
UPI_ID=lamourgourmet@oksbi
UPI_NAME="L'Amour Gourmet Restaurant"

# Payment Mode Switches
ENABLE_COD=true
ENABLE_WHATSAPP_ORDER=true

# Delivery Pricing Configuration
DELIVERY_FEE=49
FREE_DELIVERY_ABOVE=499
MIN_ORDER_AMOUNT=199

# Cloudinary Cloud Image Upload Configuration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lamour_restaurant

# SMTP & Automated Email Notifications Configuration (Optional)
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="L'Amour Gourmet & Grill <notifications@lamourgourmet.com>"
SMTP_SECURE=false

# Delivery Partner / Rider Default Account
DEFAULT_RIDER_NAME="Vikram Express (Rider)"
DEFAULT_RIDER_EMAIL=rider@restaurant.com
DEFAULT_RIDER_PASS=rider123
DEFAULT_RIDER_PHONE=+919830055443
DEFAULT_RIDER_VEHICLE="Express Thermal Bike (DL 04 EV 8892)"
