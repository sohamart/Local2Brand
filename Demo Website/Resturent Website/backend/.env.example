# ========================================================
# GOURMETOS MULTI-TENANT BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local Database Connection URI
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/gourmetos?retryWrites=true&w=majority
# Fallback local connection: mongodb://127.0.0.1:27017/gourmetos

# JWT Secret for RBAC Authentication
JWT_SECRET=gourmetos_super_secure_jwt_secret_key_2026_antigravity
JWT_EXPIRE=7d

# Razorpay Payment Gateway Credentials (Sandbox / Production)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=rzp_test_sample_key_secret

# Cloudinary Media Storage Credentials
CLOUDINARY_CLOUD_NAME=sample_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sample_cloudinary_api_secret

# Nodemailer / SMTP Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM_NAME="GourmetOS Concierge"
SMTP_FROM_EMAIL=concierge@gourmetos.io
