# ==============================================================================
# LOCAL2BRAND — Environment Configuration Template (.env.example)
# Duplicate this file to .env and change the values below.
# ==============================================================================

# Brand Identity
VITE_BRAND_NAME="LOCAL2BRAND"
VITE_BRAND_TAGLINE="Build Local. Think Global."
VITE_BRAND_SHORT_DESC="We Build Digital Experiences That Turn Local Brands Into Big Brands."
VITE_BRAND_FULL_DESC="LOCAL2BRAND designs and develops bespoke, high-converting websites and modern digital products for ambitious businesses ready to scale locally and globally."

# WhatsApp Configuration (wa.me format: e.g., 919876543210)
VITE_WHATSAPP_NUMBER="919876543210"
VITE_DISPLAY_WHATSAPP="+91 98765 43210"

# Direct Contact Information
VITE_CONTACT_EMAIL="hello@local2brand.com"
VITE_CONTACT_PHONE="+91 98765 43210"
VITE_CONTACT_ADDRESS="Pan-India Hub • Mumbai, Bengaluru, Delhi, Kolkata & Global Edge"
VITE_CONTACT_HOURS="Mon - Sat: 9:00 AM - 9:00 PM IST"

# Maintenance / Coming Soon Controls
VITE_MAINTENANCE_MODE="false"
VITE_COMING_SOON_MODE="false"
VITE_LAUNCH_TARGET_DATE="2026-09-15T00:00:00"
VITE_ADMIN_BYPASS_PASSWORD="Local2Brand@1902"

# Social Media Channels & Handles
VITE_INSTAGRAM_HANDLE="local2brand_official"
VITE_INSTAGRAM_URL="https://instagram.com/local2brand"
VITE_FACEBOOK_URL="https://facebook.com/local2brand"
VITE_LINKEDIN_URL="https://linkedin.com/company/local2brand"
VITE_TWITTER_URL="https://twitter.com/local2brand"
VITE_YOUTUBE_URL="https://youtube.com/@local2brand"

# Agency Metrics
VITE_METRIC_SPEED="99.8%"
VITE_METRIC_TURNAROUND="3 - 7 Days"
VITE_METRIC_RESPONSIVE="100%"
VITE_METRIC_SUPPORT="24/7"

# ==============================================================================
# PROMO COUPON CODES ENGINE (.ENV)
# ==============================================================================
VITE_COUPONS_LIST="INDIA2025:20,LAUNCH20:20,FESTIVE25:25,STARTUP30:30,VIP50:50"
VITE_DEFAULT_PROMO_CODE="INDIA2025"
VITE_DEFAULT_PROMO_DISCOUNT="20"
VITE_PROMO_BANNER_TITLE="Launch Special: Flat 20% Instant Discount"
VITE_PROMO_BANNER_SUBTITLE="Use promo code INDIA2025 at checkout"
