PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/local2brand

# Security & JWT
JWT_SECRET=local2brand_super_secure_jwt_secret_key_2026_ultra_safe
JWT_EXPIRES_IN=7d

# Initial Admin Credentials
ADMIN_EMAIL=admin@local2brand.com
ADMIN_PASSWORD=Admin@12345

# AI Provider Fallback Engine (Gemini -> Groq -> Cerebras -> OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# =======================================================
# DUAL-CLOUD SMART STORAGE & FAILOVER HUB
# =======================================================
STORAGE_PROVIDER_ORDER=cloudinary,imagekit
STORAGE_REPLICATION_ENABLED=false
STORAGE_HEALTH_CHECK_ENABLED=true
STORAGE_CIRCUIT_BREAKER_THRESHOLD=5
STORAGE_RECOVERY_CHECK_INTERVAL=300000

# 1. PRIMARY: Cloudinary (25 GB High-Speed CDN)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 2. AUTOMATIC FAILOVER: ImageKit.io (20 GB Global Edge CDN)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

