PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/local2brand

# Security & JWT
JWT_SECRET=local2brand_super_secure_jwt_secret_key_2026_ultra_safe
JWT_EXPIRES_IN=7d

# Initial Admin Credentials
ADMIN_EMAIL=admin@local2brand.com
ADMIN_PASSWORD=Admin@12345

# AI Provider Fallback Engine (Gemini -> Groq -> Cerebras -> OpenRouter)
# The backend automatically cascades in order if any provider returns error / quota limit (429)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama3.1-8b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
